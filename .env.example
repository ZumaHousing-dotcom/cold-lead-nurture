# ===== Supabase Edge Function secrets =====
# Set with:  supabase secrets set --env-file .env      (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically)
MAILCHIMP_API_KEY=your-key-us17            # datacenter suffix builds the API host
MAILCHIMP_LIST_ID=your_audience_id
MAILCHIMP_STATUS_IF_NEW=subscribed         # or "pending" for double opt-in
WEBHOOK_SECRET=generate-a-long-random-string   # same value goes in Netlify and in Vault (supabase/cron.sql)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
ABANDON_AFTER_MIN=60
RATE_LIMIT_PER_MIN=60

# ===== Netlify environment variables (set in the Netlify UI, NOT in front-end code) =====
# LEAD_WEBHOOK_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/webhook
# WEBHOOK_SECRET=(same value as above)
# FORM_NAME=inquiry        # optional: only forward this Netlify Form from submission-created
