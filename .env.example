# --- Python app ---
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21   # datacenter suffix is used to build the API host
MAILCHIMP_LIST_ID=your_audience_id
MAILCHIMP_STATUS_IF_NEW=subscribed                         # or "pending" for double opt-in
WEBHOOK_SECRET=generate-a-long-random-string               # same value goes in Netlify env vars
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
ABANDON_AFTER_MIN=60
SCHEDULER_INTERVAL_MIN=15
RATE_LIMIT_PER_MIN=60
DB_PATH=./data/leads.db                                    # on Render: /var/data/leads.db (persistent disk)

# --- Netlify env vars (set in the Netlify UI, NOT in front-end code) ---
PYTHON_APP_URL=https://your-app.onrender.com
# WEBHOOK_SECRET (same as above)
# FORM_NAME=inquiry   # optional: only forward this Netlify Form from submission-created
